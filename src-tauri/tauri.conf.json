{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patty Burps POS",
  "version": "1.0.0",
  "identifier": "com.pattyburps.pos",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [
      { "title": "Patty Burps POS", "width": 1280, "height": 800, "minWidth": 900, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
